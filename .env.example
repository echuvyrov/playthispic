OPENAI_API_KEY=your_api_key_here
OPENAI_OCR_MODEL=gpt-5
PORT=5174

# Register an OAuth app with Beatport before enabling account connection.
BEATPORT_CLIENT_ID=
# Only if issued for your registered app; never use your account password here.
BEATPORT_CLIENT_SECRET=
BEATPORT_REDIRECT_URI=http://127.0.0.1:5174/auth/beatport/callback
# Optional: only scopes approved for your app; leave blank to use its defaults.
BEATPORT_SCOPES=

# Spotify: create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5174/auth/spotify/callback
